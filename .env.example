# Service
LOG_LEVEL=INFO

# Gemini (OpenAI-compatible API): embeddings and answer both use this one key.
# Free key: https://aistudio.google.com/apikey. Any OpenAI-compatible provider works.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001        # 768-dim vectors (changing it needs a full re-index)
ANSWER_LLM_MODEL=gemini-3.5-flash
EVAL_LLM_MODEL=gemini-3.5-flash-lite        # judges the RAGAS evaluation (eval/run_ragas.py)

# The service under test: stored on every chunk and in its embedded header
SERVICE_NAME=payment

# Sources for POST /ingest (all optional; a source without its settings fetches nothing)
#   local_file: data/docs/ (postmortems/, runbooks/, technical/)
#   github:     the repos listed in data/sources.yaml; a token only raises the rate limit (60 -> 5000 calls/hour)
#   slack:      threads from SLACK_CHANNELS (comma-separated channel IDs; empty = every public channel the bot is in)
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNELS=

# Vector store (docker compose up -d qdrant)
QDRANT_URL=http://localhost:6333
DENSE_COLLECTION=nexgen_dense
SPARSE_COLLECTION=nexgen_bm25_terms

# Retrieval (these models run locally on CPU, downloaded on first start)
WRRF_K=60
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Compression
LLMLINGUA2_MODEL=microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank
DEFAULT_COMPRESSION_BUDGET_TOKENS=2000
